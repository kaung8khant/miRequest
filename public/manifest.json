{
  "manifest_version": 3,
  "name": "MiRequest",
  "version": "1.0",
  "description": "Chrome extension built with Vite + npm",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_width": 1000,
    "default_height": 500
  },
  "permissions": ["storage", "activeTab", "scripting"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["absence-template-miview.pdf", "pdf-lib.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
